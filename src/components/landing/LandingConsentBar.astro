---
// The in-page Allow / No thanks bar for visitors outside a US time zone. Hidden
// until landing-client.ts decides to ask; the buttons work whatever the answer.
import type { LandingStrings } from '../../i18n/landing';
import { en } from '../../i18n/landing.en';

export interface Props {
  strings?: LandingStrings;
}

const { consent } = (Astro.props.strings ?? en);
---

<div id="landing-consent" hidden class="max-w-6xl mx-auto mb-6" data-testid="landing-consent">
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 rounded-xl bg-starlight-silver px-4 py-3 text-sm text-text-secondary">
    <p class="flex-1">
      {consent.text} <a href="/cookie-policy">{consent.cookiePolicy}</a>
    </p>
    <div class="flex gap-2">
      <button type="button" data-consent="granted" data-testid="landing-consent-allow" class="btn btn-sm btn-primary">{consent.allow}</button>
      <button type="button" data-consent="denied" data-testid="landing-consent-deny" class="btn btn-sm border-text-muted text-text-secondary bg-transparent">{consent.deny}</button>
    </div>
  </div>
</div>
