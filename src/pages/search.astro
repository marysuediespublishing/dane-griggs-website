---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchClientEnhanced from '../components/SearchClientEnhanced';
import TestSearch from '../components/TestSearch';
import { SITE_TITLE } from '../consts';

// For static generation, we can't access URL params at build time
// The SearchClient component will handle everything client-side
---

<Layout title={`Search - ${SITE_TITLE}`}>
  <Header />
  
  <main>
    <!-- All search functionality is handled client-side -->
    <SearchClientEnhanced client:only="react" />
  </main>

  <Footer />
</Layout>